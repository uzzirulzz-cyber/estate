# Zaraj Properties — Environment Variables
# Copy this file to `.env` and fill in your values.
# The real `.env` is gitignored and must NEVER be committed.

# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string (Neon or any Postgres provider).
# Get yours from your Neon dashboard: https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Runtime ─────────────────────────────────────────────────
# Set automatically by Next.js. Do not set manually unless deploying.
# NODE_ENV=development|production
