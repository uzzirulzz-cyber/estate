# PropertyAtlas — Environment Variables
# Copy this file to `.env` and fill in your values.
# The real `.env` is gitignored and must NEVER be committed.

# ── Database ────────────────────────────────────────────────
# MongoDB Atlas connection string.
# Get yours from your Atlas dashboard: https://cloud.mongodb.com
# Include the database name in the path (e.g. /zaraj).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/zaraj?appName=Cluster0"

# ── Runtime ─────────────────────────────────────────────────
# Set automatically by Next.js. Do not set manually unless deploying.
# NODE_ENV=development|production
