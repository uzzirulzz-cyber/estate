# Zaraj Properties — Environment Variables
# Copy this file to `.env` and adjust values as needed.
# The real `.env` is gitignored and must never be committed.

# ── Database ────────────────────────────────────────────────
# SQLite connection string (file-based, no DB server required).
# Path is relative to the project root.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ── Runtime ─────────────────────────────────────────────────
# Set automatically by Next.js. Do not set manually unless deploying.
# NODE_ENV=development|production
